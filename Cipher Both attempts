#ceaser cypher

letters = ["a","b","c","d","e","f","g","h","i","j","k","l", "m", "n", "o","p","q","r","s","t","u","v","w","x","y","z"]
wordlist = input("Write whatever you want: ")

def ceaser():
    global wordlist
    input_string = []
    shift = int(input("Enter a number 1-26: "))
    encrypted = []
    for word in wordlist:
        input_string.append(word)
    for Word in input_string:
        for letter in Word:
            if letter in letters:
                index = letters.index(letter) + shift
                letter = letters[index]
        encrypted.append(Word)
   
    print(encrypted)

ceaser()

